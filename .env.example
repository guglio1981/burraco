# ── Server ──────────────────────────────────────────────
# Postgres (Neon) — connection string pooled
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Segreto per firmare i JWT (stringa lunga e casuale)
JWT_SECRET=change-me-to-a-long-random-string
# Porta del server (REST + WebSocket)
PORT=8787
# Origine del client autorizzata (CORS / WS)
CLIENT_ORIGIN=http://localhost:5173

# ── Push notifications (FASE 2) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Web (Vite) ──────────────────────────────────────────
# In apps/web/.env (prefisso VITE_)
VITE_API_URL=http://localhost:8787
VITE_WS_URL=ws://localhost:8787
# Chiave VAPID pubblica (uguale a VAPID_PUBLIC_KEY del server)
VITE_VAPID_PUBLIC_KEY=
# Genera le chiavi con: cd apps/server && npx web-push generate-vapid-keys
